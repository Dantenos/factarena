generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum RoundStatus {
  COUNTDOWN
  OPEN
  LOCKED
  REVEALED
  FINISHED
}

enum ClaimTruthLabel {
  TRUE
  FALSE
}

enum PredictionResult {
  WIN
  LOSS
}

enum TransactionType {
  BET
  PAYOUT
  BONUS
  REFUND
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String        @id @default(cuid())
  email          String        @unique
  displayName    String?       @unique
  role           String        @default("USER")
  passwordHash   String?
  oauthProvider  String?
  oauthProviderId String?
  avatarUrl      String?
  status         UserStatus    @default(OFFLINE)
  virtualBalance Int           @default(1000)
  experience    Int           @default(0)
  level         Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  rooms        Room[]        @relation("RoomHost")
  bets         Bet[]
  clipVotes    ClipVote[]
  transactions Transaction[]
  friends      Friend[]      @relation("Friendships")
  friendOf     Friend[]      @relation("FriendTargets")
  messages     Message[]
  clipReports  ClipReport[]
  createdClaims Claim[]    @relation("ClaimCreator")
  achievements  AchievementUnlock[]

  @@unique([oauthProvider, oauthProviderId])
}

model AchievementUnlock {
  id              String   @id @default(cuid())
  userId          String
  achievementKey  String
  unlockedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, achievementKey])
  @@index([userId, unlockedAt])
}

model Friend {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    FriendStatus @default(ACCEPTED)
  createdAt DateTime @default(now())

  user   User @relation("Friendships", fields: [userId], references: [id])
  friend User @relation("FriendTargets", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
}

model RoomPresence {
  socketId    String   @id
  userId      String
  roomId      String
  lastSeenAt  DateTime @default(now())

  @@index([roomId, lastSeenAt])
  @@index([userId, lastSeenAt])
}

model Room {
  id        String     @id @default(cuid())
  name      String
  status    RoomStatus @default(WAITING)
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  host     User     @relation("RoomHost", fields: [createdBy], references: [id])
  rounds   Round[]
  messages Message[]
}

model Round {
  id            String      @id @default(cuid())
  roomId        String
  status        RoundStatus @default(OPEN)
  currentClipIndex Int       @default(0)
  opensAt       DateTime    @default(now())
  locksAt       DateTime
  revealedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  room        Room          @relation(fields: [roomId], references: [id])
  bets        Bet[]
  clipVotes   ClipVote[]
  roundClaims RoundClaim[]
}

model Claim {
  id         String          @id @default(cuid())
  sourceKey  String?         @unique
  createdBy  String?
  text       String
  mediaRef   String?
  videoEndS  Int?
  truthLabel ClaimTruthLabel
  category   String?
  sourceUrl  String?
  createdAt  DateTime        @default(now())

  roundClaims RoundClaim[]
  clipVotes   ClipVote[]
  verdicts    ClaimVerdict[]
  reports     ClipReport[]
  creator    User?           @relation("ClaimCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
}

model RoundClaim {
  id         String @id @default(cuid())
  roundId    String
  claimId    String
  orderIndex Int

  round Round @relation(fields: [roundId], references: [id])
  claim Claim @relation(fields: [claimId], references: [id])

  @@unique([roundId, orderIndex])
}

model ClipReport {
  id        String   @id @default(cuid())
  claimId   String
  userId    String
  roundId   String?
  reason    String?
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([userId, claimId])
  @@index([claimId])
}

model ClaimVerdict {
  id          String  @id @default(cuid())
  claimId     String  @unique
  verdictText String
  confidence  Float?
  citations   Json?

  claim Claim @relation(fields: [claimId], references: [id])
}

model Bet {
  id        String         @id @default(cuid())
  userId    String
  roundId   String
  stake     Int
  payout    Int?
  result    PredictionResult?
  createdAt DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id])
  round Round @relation(fields: [roundId], references: [id])

  @@unique([userId, roundId])
  @@index([roundId])
}

model ClipVote {
  id        String   @id @default(cuid())
  userId    String
  roundId   String
  claimId   String
  isFake    Boolean
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  round Round @relation(fields: [roundId], references: [id])
  claim Claim @relation(fields: [claimId], references: [id])

  @@unique([userId, roundId, claimId])
  @@index([roundId])
  @@index([claimId])
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  amount       Int
  balanceAfter Int
  referenceId  String?         @unique
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
