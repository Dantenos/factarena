// ============================================================
// FactArena — schéma de données (Prisma / PostgreSQL)
// Possédé par le back-core (NestJS). POURQUOI ici : Prisma est l'ORM imposé ;
// ce fichier est la source unique du modèle relationnel et des migrations.
//
// ATTENTION : SCHÉMA MINIMAL (initialisation). On démarre volontairement avec
// la SEULE table User. Le modèle complet cible (Room, Round, Claim, Prediction,
// Transaction, ClaimVerdict, Stat...) est décrit dans docs/ARCHITECTURE.md et
// sera ajouté au fur et à mesure. Chacun ajoute SES tables ici quand il code
// sa feature.
//
// Rappel (docs/ARCHITECTURE.md §5.2) : la table des embeddings (pgvector) N'EST
// PAS gérée par Prisma mais par le service back-ai (FastAPI), dans la même base.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Statut de présence de l'utilisateur (affiché aux amis).
enum UserStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum RoundStatus {
  OPEN
  LOCKED
  REVEALED
}

enum ClaimTruthLabel {
  TRUE
  FALSE
}

enum PredictionResult {
  WIN
  LOSS
}

enum TransactionType {
  BET
  PAYOUT
  BONUS
  REFUND
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique // identifiant de connexion (auth email + mot de passe)
  passwordHash String        // hash Argon2/bcrypt (le sel est intégré au hash) — jamais le mot de passe en clair
  avatarUrl    String?       // avatar optionnel (un défaut est fourni côté app)
  status       UserStatus    @default(OFFLINE)
  virtualBalance Int         @default(1000)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  rooms        Room[]        @relation("RoomHost")
  predictions  Prediction[]
  transactions Transaction[]
}

model Room {
  id        String     @id @default(cuid())
  name      String
  status    RoomStatus @default(WAITING)
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  host   User     @relation("RoomHost", fields: [createdBy], references: [id])
  rounds Round[]
}

model Round {
  id            String      @id @default(cuid())
  roomId        String
  status        RoundStatus @default(OPEN)
  opensAt       DateTime    @default(now())
  locksAt       DateTime
  revealedAt    DateTime?
  trueFakeCount Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  room        Room          @relation(fields: [roomId], references: [id])
  predictions Prediction[]
  roundClaims RoundClaim[]
}

model Claim {
  id         String          @id @default(cuid())
  text       String
  mediaRef   String?
  truthLabel ClaimTruthLabel
  category   String?
  sourceUrl  String?
  createdAt  DateTime        @default(now())

  roundClaims RoundClaim[]
  verdicts    ClaimVerdict[]
}

model RoundClaim {
  id         String @id @default(cuid())
  roundId    String
  claimId    String
  orderIndex Int

  round Round @relation(fields: [roundId], references: [id])
  claim Claim @relation(fields: [claimId], references: [id])

  @@unique([roundId, orderIndex])
}

model ClaimVerdict {
  id          String  @id @default(cuid())
  claimId     String  @unique
  verdictText String
  confidence  Float?
  citations   Json?

  claim Claim @relation(fields: [claimId], references: [id])
}

model Prediction {
  id                  String           @id @default(cuid())
  userId              String
  roundId             String
  predictedFakeCount  Int
  stake               Int
  payout              Int?
  result              PredictionResult?
  createdAt           DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id])
  round Round @relation(fields: [roundId], references: [id])

  @@unique([userId, roundId])
  @@index([roundId])
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  amount       Int
  balanceAfter Int
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
