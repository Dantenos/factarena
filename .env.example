# ============================================================
# ft_transcendence — variables d'environnement
# Copiez ce fichier en .env puis remplissez les valeurs.
# .env is ignoré par git : les secrets ne quittent jamais votre machine.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence
DATABASE_URL=postgresql://transcendence:changeme@postgres:5432/transcendence

# --- Backend core (NestJS) ---
# Secret de signature des JWT : longue chaîne aléatoire (openssl rand -hex 32)
JWT_SECRET=changeme
# Adresse INTERNE du service IA (appelé par le backend sur le réseau docker).
# « ai-service » est le nom du service dans docker-compose.yml.
AI_SERVICE_URL=http://ai-service:8000

# --- OAuth 42 (module mineur) : créés sur profile.intra.42.fr/oauth/applications ---
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=https://localhost/api/auth/42/callback

# --- Frontend URL pour redirection OAuth ---
FRONTEND_URL=http://localhost:5173

# --- Service IA (FastAPI) — fournisseur : Mistral (https://console.mistral.ai) ---
# Clé API Mistral (La Plateforme). Le tier gratuit suffit pour développer.
# C'est un SECRET : on ne la commite jamais (ce fichier .example reste vide).
LLM_API_KEY=
# Noms des modèles. Le code fournit déjà ces valeurs par défaut ; ces lignes
# servent à documenter le choix et à pouvoir surcharger sans toucher au code.
LLM_MODEL=mistral-small-latest
EMBEDDING_MODEL=mistral-embed
MODERATION_MODEL=mistral-moderation-latest

# --- Données de démonstration Prisma ---
# En développement, le seed les active par défaut. En production, activez-les
# explicitement uniquement sur un environnement de test : les identifiants sont
# volontairement connus.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- DevOps ELK services for logs management ---
LOGSTASH_ENV=development
LOGSTASH_USER=logstash_writer
LOGSTASH_PASSWORD=

ELASTIC_PASSWORD=
GRAFANA_PASSWORD=
KIBANA_USER=kibana_system
KIBANA_PASSWORD=

KIBANA_APP_USER=factarena
KIBANA_APP_PASSWORD=