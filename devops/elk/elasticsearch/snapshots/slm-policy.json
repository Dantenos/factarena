{
  "schedule": "0 0 2 * * ?",
  "name": "<factarena-snapshot-{now/d}>",
  "repository": "factarena_backup",
  "config": {
    "indices": [
      "factarena-logs-*"
    ],
    "include_global_state": true
  },
  "retention": {
    "expire_after": "90d",
    "min_count": 7,
    "max_count": 100
  }
}