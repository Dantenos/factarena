{
  "index_patterns": [
    "factarena-logs-*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.lifecycle.name": "factarena_logs_policy"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "message": {
          "type": "text"
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            },
            "source": {
              "type": "keyword"
            },
            "collector": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "kind": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "severity": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            }
          }
        },
        "docker": {
          "properties": {
            "container": {
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "client": {
          "properties": {
            "address": {
              "type": "ip"
            }
          }
        }
      }
    }
  }
}